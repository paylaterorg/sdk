{
  "name": "@paylater/sdk",
  "version": "1.0.1",
  "type": "module",
  "description": "Frictionless USDT checkout. Tap, sign, done. Pay within 30 days. Drop-in widget for partner platforms.",
  "license": "MIT",
  "homepage": "https://paylater.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paylaterorg/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/paylaterorg/sdk/issues"
  },
  "keywords": [
    "paylater",
    "bnpl",
    "usdt",
    "checkout",
    "widget",
    "crypto",
    "stablecoin",
    "30-day",
    "deferred-payment",
    "eid",
    "shadow-dom"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./webhooks": {
      "node": {
        "types": "./dist/webhooks/index.d.ts",
        "import": "./dist/webhooks/index.js",
        "require": "./dist/webhooks/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:bundle": "node scripts/assert-no-node-builtins.mjs",
    "test": "tsx --test --test-force-exit --test-timeout=30000 tests/**/*.test.ts",
    "prepublishOnly": "npm run build && npm run verify:bundle"
  },
  "dependencies": {
    "@web3icons/react": "^4.1.17",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.0": true
  }
}
